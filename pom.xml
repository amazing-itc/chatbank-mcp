<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>br.com.chatbank.kit</groupId>
    <artifactId>chatbank-mcp</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ChatBank MCP Kit</name>
    <description>Tutorial e implementação de referência MCP somente-leitura para bancos (saldo e extrato)</description>

    <modules>
        <module>kit-provider-api</module>
        <module>kit-core</module>
        <module>kit-usecases</module>
        <module>kit-auth</module>
        <module>mock-bank</module>
        <module>starter-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <spring-ai.version>2.0.0-M8</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>br.com.chatbank.kit</groupId>
                <artifactId>kit-provider-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.chatbank.kit</groupId>
                <artifactId>kit-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.chatbank.kit</groupId>
                <artifactId>kit-usecases</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.chatbank.kit</groupId>
                <artifactId>mock-bank</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.chatbank.kit</groupId>
                <artifactId>kit-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
